# Configure these on the hosting platform. Never put keys in VITE_* variables.
OPENAI_API_KEY=
# Base API URL, without /responses. Compatible providers can change this.
OPENAI_BASE_URL=https://api.openai.com/v1
# Use a model offered by your provider that supports Responses + function tools.
OPENAI_MODEL=

# Local scheduled-task email reports only; do not configure these in the public web service.
SMTP_USER=
# QQ Mail SMTP authorization code, not your login password.
SMTP_PASSWORD=
# Optional; defaults to SMTP_USER, smtp.qq.com and SSL port 465.
# SMTP_TO=
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465

# Feishu publishing; see README-feishu.md. Keep real values in the local .env.
FEISHU_APP_SECRET=
FEISHU_WEBHOOK=
